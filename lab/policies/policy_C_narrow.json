{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ReadOneBucket", "Effect": "Allow",
     "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
     "Resource": "arn:aws:s3:::blast-lab-bucket"},
    {"Sid": "ReadOneBucketObjects", "Effect": "Allow",
     "Action": ["s3:GetObject"],
     "Resource": "arn:aws:s3:::blast-lab-bucket/*"},
    {"Sid": "WriteOwnLogs", "Effect": "Allow",
     "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": "arn:aws:logs:*:*:log-group:/blast-lab/*"},
    {"Sid": "WhoAmI", "Effect": "Allow",
     "Action": ["sts:GetCallerIdentity"], "Resource": "*"}
  ]
}
